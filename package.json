{
  "name": "wenstar",
  "version": "1.0.0",
  "description": "情感伴侣类脑认知系统 - M1 DNA编码器模块",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "cleanup:tmp": "node scripts/cleanup-tmp.mjs",
    "cleanup:backups": "node scripts/cleanup-backups.mjs",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:full": "node scripts/test-full-local.cjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sandbox": "npx tsx src/cli/sandbox.ts",
    "stress-test": "npx tsx test/run-all-stress.ts",
    "webui": "node start.cjs",
    "health": "node ./node_modules/tsx/dist/cli.mjs src/cli/health-check.ts",
    "fg:maintenance": "node ./node_modules/tsx/dist/cli.mjs scripts/fg-maintenance.ts",
    "port:3000": "node scripts/check-port-3000.cjs",
    "wait:health": "node scripts/wait-for-health.cjs",
    "smoke:api": "node ./node_modules/vitest/vitest.mjs run scripts/__tests__/runtime-api-smoke.test.ts",
    "smoke:checkpoint": "node ./node_modules/vitest/vitest.mjs run scripts/__tests__/coverage-gap-read-runtime-smoke.test.ts scripts/__tests__/chat-stream-runtime-smoke.test.ts scripts/__tests__/websocket-connectivity-runtime-smoke.test.ts scripts/__tests__/webui-static-runtime-smoke.test.ts scripts/__tests__/m6-m8-runtime-smoke.test.ts scripts/__tests__/knowledge-family-runtime-smoke.test.ts scripts/__tests__/memory-roundtrip-runtime-smoke.test.ts scripts/__tests__/sse-connectivity-runtime-smoke.test.ts scripts/__tests__/m5-orchestrator-core-smoke.test.ts scripts/__tests__/core-flow-runtime-smoke.test.ts scripts/__tests__/family-graph-db-health.test.ts scripts/__tests__/provider-selection-smoke.test.ts scripts/__tests__/no-api-smoke.test.ts scripts/__tests__/runtime-api-smoke.test.ts",
    "runtime:check": "node scripts/runtime-workflow.cjs",
    "ci:ready": "node scripts/ci-ready.cjs",
    "profile:chat": "node scripts/profile-chat-latency.cjs",
    "agent-cnc": "tsx src/agent-cnc/cli.ts",
    "agent-cnc:doctor": "tsx src/agent-cnc/cli.ts doctor",
    "agent-cnc:scan": "tsx src/agent-cnc/cli.ts scan",
    "agent-cnc:validate": "tsx src/agent-cnc/cli.ts validate",
    "agent-cnc:guard": "tsx src/agent-cnc/cli.ts guard",
    "agent-cnc:report": "tsx src/agent-cnc/cli.ts report"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "ws": "^8.21.1",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@zvec/zvec": "^0.5.0",
    "better-sqlite3": "^12.11.1",
    "busboy": "^1.6.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "sql.js": "^1.11.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  }
}
