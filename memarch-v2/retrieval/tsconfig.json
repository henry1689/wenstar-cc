{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "query_understanding/**/*.ts",
    "recall/**/*.ts",
    "fusion/**/*.ts",
    "rerank/**/*.ts",
    "postprocess/**/*.ts",
    "degrade/**/*.ts",
    "__tests__/**/*.ts",
    "bench/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
